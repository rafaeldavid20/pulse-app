rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Models & Schema Rules
    // ===============================================================
    // Collection: workspaces (id, name, slug, ownerId, createdAt)
    // Collection: teams (id, workspaceId, name, key, issueCount, createdAt)
    // Collection: members (id, workspaceId, userId, role, displayName, email, photoURL, joinedAt)
    // Collection: issues (id, teamId, identifier, number, title, status, priority, creatorId, createdAt, ...)
    // Collection: projects (id, teamId, name, status, createdAt, ...)
    // Collection: comments (id, issueId, authorId, body, createdAt)
    // Collection: activity (id, issueId, actorId, type, createdAt)

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() >= minLen &&
             request.resource.data[field].size() <= maxLen;
    }

    function isValidIssue() {
      return hasRequiredFields(['teamId', 'identifier', 'title', 'status', 'priority', 'creatorId']) &&
             request.resource.data.title is string &&
             request.resource.data.title.size() > 0 &&
             request.resource.data.title.size() <= 300 &&
             request.resource.data.priority is number &&
             request.resource.data.priority >= 0 &&
             request.resource.data.priority <= 4;
    }

    function isValidProject() {
      return hasRequiredFields(['teamId', 'name', 'status']) &&
             request.resource.data.name is string &&
             request.resource.data.name.size() > 0 &&
             request.resource.data.name.size() <= 200;
    }

    function isValidComment() {
      return hasRequiredFields(['issueId', 'authorId', 'body']) &&
             request.resource.data.body is string &&
             request.resource.data.body.size() > 0 &&
             request.resource.data.body.size() <= 5000;
    }

    // ===============================================================
    // Rules Rules Mapping
    // ===============================================================

    match /workspaces/{workspaceId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
    }

    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
    }

    match /issues/{issueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidIssue();
      allow update: if isAuthenticated() && isValidIssue();
      allow delete: if isAuthenticated();
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidProject();
      allow update: if isAuthenticated() && isValidProject();
      allow delete: if isAuthenticated();
    }

    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidComment();
      allow update: if isAuthenticated() && isValidComment();
      allow delete: if isAuthenticated();
    }

    match /activity/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    match /labels/{labelId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
  }
}
