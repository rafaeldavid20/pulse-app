rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rules per collection
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    match /workspaces/{workspaceId} {
      allow read, write: if isAuthenticated();
    }

    match /members/{memberId} {
      allow read, write: if isAuthenticated();
    }

    match /invitations/{invitationId} {
      allow read, write: if isAuthenticated();
    }

    match /teams/{teamId} {
      allow read, write: if isAuthenticated();
    }

    match /issues/{issueId} {
      allow read, write: if isAuthenticated();
    }

    match /projects/{projectId} {
      allow read, write: if isAuthenticated();
    }

    match /labels/{labelId} {
      allow read, write: if isAuthenticated();
    }

    // Atomic issue-numbering counters (workspaceId_teamId -> value).
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // Comments on issues. Mirrored in pulse-backend/firestore.rules — both
    // repos deploy rules to the same project and the last push wins, so a
    // collection the client needs open must be declared identically here too.
    match /comments/{commentId} {
      allow read, write: if isAuthenticated();
    }
  }
}
